
rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {

    // Admin verification
    function isAdmin() {
      return request.auth != null
        && get(
          /databases/$(database)/documents/users/$(request.auth.uid)
        ).data.role == 'admin';
    }

    // ==========================================
    // USER PROFILES
    // ==========================================

    match /users/{userId} {

      allow read: if request.auth != null
        && (request.auth.uid == userId || isAdmin());

      allow create: if request.auth != null
        && request.auth.uid == userId
        && request.resource.data.keys().hasOnly([
          'firstName',
          'lastName',
          'username',
          'usernameLowercase',
          'phoneNumber',
          'email',
          'createdAt'
        ])
        && request.resource.data.firstName is string
        && request.resource.data.lastName is string
        && request.resource.data.username is string
        && request.resource.data.usernameLowercase is string
        && request.resource.data.usernameLowercase
          == request.resource.data.username.lower()
        && request.resource.data.phoneNumber is string
        && request.resource.data.email == request.auth.token.email
        && request.resource.data.createdAt == request.time;

      // Owners can update permitted profile fields.
      // Admins can update any profile.
      allow update: if isAdmin()
        || (
          request.auth != null
          && request.auth.uid == userId
          && request.resource.data.diff(resource.data)
            .affectedKeys()
            .hasOnly([
              'firstName',
              'lastName',
              'username',
              'phoneNumber'
            ])
        );

      allow delete: if false;
    }


    // ==========================================
    // KYC DOCUMENTS
    // ==========================================

    match /users/{userId}/kyc/{kycId} {

      // Only the account owner can read their KYC records.
      allow read: if request.auth != null
        && request.auth.uid == userId;

      // KYC submissions and reviews must be handled
      // through trusted server-side functions.
      allow write: if false;
    }


    // ==========================================
    // USER FINANCIAL TRANSACTIONS
    // ==========================================

    match /users/{userId}/{collection}/{docId} {

      // Exclude KYC because it has dedicated security rules.
      allow read: if collection != 'kyc'
        && request.auth != null
        && (
          request.auth.uid == userId
          || isAdmin()
        );

      allow create: if collection != 'kyc'
        && request.auth != null
        && request.auth.uid == userId
        && request.resource.data.status == 'pending'
        && request.resource.data.createdAt == request.time;

      allow update, delete: if collection != 'kyc'
        && isAdmin();
    }


    // ==========================================
    // DEPOSIT ADDRESSES
    // ==========================================

    match /deposit_addresses/{docId} {

      allow read: if request.auth != null;

      allow write: if isAdmin();
    }


    // ==========================================
    // SECURITY AUDIT LOGS
    // ==========================================

    match /security_logs/{docId} {

      allow read, write: if isAdmin();
    }


    // ==========================================
    // PUBLIC SITE EVENTS
    // ==========================================

    match /site_events/{docId} {

      allow read: if resource.data.published == true
        || isAdmin();

      allow write: if isAdmin();
    }


    // ==========================================
    // PLATFORM ANNOUNCEMENTS
    // ==========================================

    match /announcements/{docId} {

      allow read: if request.auth != null;

      allow write: if isAdmin();
    }

  }
}
