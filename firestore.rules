rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {

    // An operator is any signed-in user whose profile carries role == 'admin'.
    // `get()` performs a direct document lookup that is not itself subject to
    // these rules, so this works even though `users/{userId}` is owner-read.
    function isAdmin() {
      return request.auth != null
        && get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role == 'admin';
    }

    match /users/{userId} {
      allow read: if request.auth != null && (request.auth.uid == userId || isAdmin());
      // Login flow: resolve a username to its account email. The query must be
      // filtered by username and limited to a single result to prevent
      // enumeration of the member directory.
      allow list: if request.query.limit <= 1
        && request.query.where.username is string;
      allow create: if request.auth != null
        && request.auth.uid == userId
        && request.resource.data.keys().hasOnly([
          'firstName',
          'lastName',
          'username',
          'phoneNumber',
          'email',
          'createdAt'
        ])
        && request.resource.data.firstName is string
        && request.resource.data.lastName is string
        && request.resource.data.username is string
        && request.resource.data.phoneNumber is string
        && request.resource.data.email == request.auth.token.email
        && request.resource.data.createdAt == request.time;
      // An owner may only edit their own profile fields; an admin may update
      // any profile (e.g. role or account status) from the admin console.
      allow update: if isAdmin()
        || (request.auth != null
          && request.auth.uid == userId
          && request.resource.data.diff(resource.data).affectedKeys().hasOnly([
            'firstName',
            'lastName',
            'username',
            'phoneNumber'
          ]));
      allow delete: if false;
    }

    // Per-user money-flow records: deposits, transfers, swaps, fixedDeposits,
    // payouts, disputes and escrows. A signed-in owner may only create a
    // `pending` request; settlement (approve / reject) is performed by an
    // admin, and owners cannot modify or remove their submitted records.
    match /users/{userId}/{collection}/{docId} {
      allow read: if request.auth != null && (request.auth.uid == userId || isAdmin());
      allow create: if request.auth != null
        && request.auth.uid == userId
        && request.resource.data.status == 'pending'
        && request.resource.data.createdAt == request.time;
      allow update, delete: if isAdmin();
    }

    // Platform deposit receiving addresses, managed by admins and read by
    // signed-in members so they can copy the correct wallet / crypto address.
    match /deposit_addresses/{docId} {
      allow read: if request.auth != null;
      allow write: if isAdmin();
    }
  }
}
